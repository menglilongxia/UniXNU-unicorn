+STATIC
+CHAR8 *
+CollectRamoops (
+  OUT UINTN  *LogLen
+  )
+{
+  volatile UINT32  *Header;
+  UINT32           Sig;
+  UINT32           Start;
+  UINT32           Size;
+  UINT32           Capacity;
+  UINT32           Take;
+  UINT32           Index;
+  UINTN            Used;
+  UINTN            Cap;
+  CHAR8            *Log;
+  CHAR8            C;
+
+  Header   = (volatile UINT32 *)(UINTN)RAMOOPS_BASE;
+  Sig      = Header[0];
+  Start    = Header[1];
+  Size     = Header[2];
+  Capacity = RAMOOPS_BYTES - RAMOOPS_HEADER;
+
+  if ((Start >= Capacity) || (Size > Capacity)) {
+    Start = 0;
+    Size  = MIN (Size, Capacity);
+  }
+
+  Take = MIN (Size, RAMOOPS_RECENT_BYTES);
+  Cap  = Take + 192;
+  Log  = AllocatePool (Cap);
+  if (Log == NULL) {
+    *LogLen = 0;
+    return NULL;
+  }
+
+  Used = AsciiSPrint (
+           Log,
+           Cap,
+           "RAMOOPS: sig=0x%08x start=0x%x size=0x%x take=0x%x\n",
+           Sig,
+           Start,
+           Size,
+           Take
+           );
+  if ((Sig != RAMOOPS_MAGIC) || (Size == 0)) {
+    AsciiSPrint (Log + Used, Cap - Used, "(no XNU console mirror)\n");
+    *LogLen = AsciiStrLen (Log);
+    return Log;
+  }
+
+  for (Index = 0; Index < Take; Index++) {
+    UINT32 Offset;
+
+    Offset = (Start + Size - Take + Index) % Capacity;
+    C      = *(volatile CHAR8 *)(UINTN)(RAMOOPS_BASE + RAMOOPS_HEADER + Offset);
+    if ((C < 0x20) || (C > 0x7e)) {
+      C = ((C == '\n') || (C == '\r') || (C == '\t')) ? C : '.';
+    }
+
+    if ((Used + 1 >= Cap) || (Used + 2 >= Cap)) {
+      break;
+    }
+
+    Log[Used++] = C;
+  }
+
+  Log[Used++] = '\n';
+  Log[Used]   = '\0';
+  *LogLen = Used;
+  return Log;
+}
